<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FIA'O - Deudas y Pagos</title>
<meta name="description" content="FIA'O: controla fiados, pagos, clientes e inventario de tu negocio.">
<meta name="theme-color" content="#c91b1c">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http\://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23c91b1c'/%3E%3Ctext x='32' y='44' font-size='34' font-weight='900' text-anchor='middle' fill='%23ffbf32' font-family='Arial'%3EF%3C/text%3E%3C/svg%3E">

<style>:root{
  --red-900:#8f1117; --red-700:#a91418; --red-600:#c91b1c; --red-500:#e02a2a;
  --gold:#ffbf32; --gold-soft:#ffa92e; --cream:#fff1c2; --ink:#482d1f; --ink-soft:#8a6854;
  --green:#1f9d55; --card-a:#f9b8a0; --card-b:#ee7a7a;
  --radius:18px; --shadow:0 18px 40px rgba(62,0,0,.28);
  --font:"Inter","Segoe UI",system-ui,-apple-system,Arial,sans-serif;
}
body.dark{--card-a:#6d1a1f;--card-b:#4a0f13;--ink:#ffe9d6;--ink-soft:#e8b9a5}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:#fff;min-height:100vh;
  background:radial-gradient(circle at 10% 20%,rgba(255,191,50,.28),transparent 28%),
  radial-gradient(circle at 85% 85%,rgba(255,191,50,.15),transparent 30%),
  linear-gradient(135deg,var(--red-900),var(--red-600) 45%,var(--red-700)) fixed}
body[data-page="products"]:not(.dark){background:var(--cream)}
button,input,select,textarea{font-family:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
body:not(.authed) #app{display:none}
body.authed #authScreen{display:none}

.navbar{position:sticky;top:12px;z-index:50;margin:12px auto 0;width:min(1500px,calc(100% - 24px));display:flex;align-items:center;justify-content:space-between;
  padding:12px 28px;border-radius:14px;border:1px solid rgba(255,255,255,.4);box-shadow:var(--shadow);
  background:linear-gradient(100deg,rgba(225,95,62,.95),rgba(255,40,40,.95));backdrop-filter:blur(14px)}
.logo{font-size:26px;font-weight:900;letter-spacing:-1.5px}.logo span{color:var(--gold)}
.nav-links{display:flex;gap:10px;flex-wrap:wrap}
.nav-links button{border:1px solid rgba(255,255,255,.5);background:var(--gold-soft);color:#3b1a05;font-weight:700;font-size:13px;padding:8px 20px;border-radius:999px;transition:.2s}
.nav-links button:hover{transform:translateY(-1px);background:var(--gold)}
.nav-links button.active{background:#fff;color:var(--red-700)}
.menu{display:none;background:var(--gold-soft);border:0;border-radius:10px;font-size:20px;padding:6px 12px}

.toolbar{width:min(900px,calc(100% - 32px));margin:18px auto 0;display:flex;justify-content:flex-end;gap:8px;padding-bottom:16px;border-bottom:1px solid var(--gold)}
.tool{position:relative;border:1px solid rgba(255,255,255,.5);background:rgba(255,255,255,.14);color:#fff;border-radius:10px;padding:6px 12px;font-size:13px;font-weight:700;backdrop-filter:blur(8px)}
.badge{position:absolute;top:-8px;right:-6px;background:var(--gold);color:#3b1a05;border-radius:50%;width:18px;height:18px;font-size:11px;display:grid;place-items:center}

.page{display:none;padding:34px 16px 60px}.page.active{display:block}
.container{width:min(1180px,100%);margin:0 auto}
.hero{width:min(900px,100%);margin:0 auto 22px}
.hero h1,.page-head h1{font-size:clamp(30px,5vw,44px);letter-spacing:-1.5px;font-weight:900}
.hero h1 span,.page-head h1 span{color:var(--gold)}
.hero p,.page-head p{margin-top:8px;font-size:14px;opacity:.92}
.page-head{margin-bottom:22px}
body[data-page="products"]:not(.dark) .page-head h1,body[data-page="products"]:not(.dark) .page-head p{color:#4a1f14}
body[data-page="products"]:not(.dark) .page-head h1 span{color:var(--red-600)}

.dashboard{width:min(1000px,100%);margin:0 auto;display:grid;grid-template-columns:1fr 1.15fr .95fr;gap:22px;align-items:start}
.col{display:grid;gap:22px}
.action-grid{width:min(900px,100%);margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:16px}
footer{text-align:center;font-size:11px;font-weight:700;padding:30px 16px 40px;opacity:.9}

.notification{position:fixed;right:20px;bottom:20px;z-index:100000;background:#fff;color:var(--red-700);font-weight:700;padding:14px 20px;border-radius:12px;box-shadow:var(--shadow);transform:translateY(120px);opacity:0;transition:.3s;max-width:320px;border-left:5px solid var(--gold)}
.notification.show{transform:none;opacity:1}

@media(max-width:900px){
  .dashboard,.action-grid{grid-template-columns:1fr}
  .menu{display:block}
  .nav-links{display:none;position:absolute;top:100%;left:0;right:0;margin-top:8px;padding:14px;border-radius:14px;background:rgba(160,20,24,.96)}
  .nav-links.open{display:flex}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

@media print{.navbar,.toolbar,footer,.notification,.button-row,.report-filters,#authScreen{display:none!important}body{background:#fff!important;color:#000}.page{display:none!important}.page.active{display:block!important}}

.card{background:linear-gradient(135deg,var(--card-a),var(--card-b));color:var(--ink);border:1px solid rgba(255,255,255,.55);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow),inset 0 1px 1px rgba(255,255,255,.5)}
.card h2{font-size:16px;margin-bottom:10px}.subtitle{font-size:11px;color:var(--ink-soft);margin-bottom:12px;line-height:1.5}
.card select,.form-group input,.form-group select,.form-group textarea,.modal-fields input,.modal-fields select{width:100%;padding:11px 12px;border-radius:10px;border:1px solid rgba(143,17,23,.18);background:rgba(255,255,255,.85);color:#482d1f;font-size:13px}
.form-group{margin-bottom:12px}.form-group label,.modal-fields label{display:block;font-size:11px;font-weight:800;margin-bottom:5px}
.customer-title{font-size:18px;font-weight:800;margin-bottom:12px}
.stats,.overview-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:rgba(255,255,255,.85);border-radius:12px;padding:12px;color:#482d1f}.stat small{display:block;font-size:10px;margin-bottom:6px}.stat strong{font-size:17px}
.red{color:var(--red-600)}
.progress-info{display:flex;justify-content:space-between;font-size:10px;margin:12px 0 6px}
.progress{height:8px;border-radius:99px;background:rgba(255,255,255,.8);overflow:hidden}.progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--red-700),var(--red-500));transition:width .5s}
.primary{border:1px solid rgba(255,255,255,.6);background:linear-gradient(135deg,#ffcf58,var(--gold-soft));color:#3b1a05;font-weight:800;font-size:12px;padding:10px 16px;border-radius:10px;box-shadow:0 5px 12px rgba(120,40,0,.18)}
.primary:hover{filter:brightness(1.06)}
.secondary{border:1px solid rgba(255,255,255,.6);background:rgba(255,255,255,.85);color:#482d1f;font-weight:700;font-size:12px;padding:10px 16px;border-radius:10px}
.button-row{display:flex;gap:8px;flex-wrap:wrap}
.history-list,#activityList{display:grid;gap:10px;margin-bottom:14px}
.h-item{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.88);color:#482d1f;border-radius:12px;padding:10px}
.h-date{flex:0 0 auto;width:40px;text-align:center;border:1px solid var(--gold);border-radius:8px;font-size:12px;font-weight:800;padding:3px;line-height:1.1}.h-date small{display:block;font-size:8px}
.h-main{flex:1;min-width:0;font-size:12px;font-weight:700}.h-main small{display:block;font-weight:400;color:var(--ink-soft);font-size:10px}
.h-amt{font-weight:800;font-size:13px;color:var(--red-600)}.h-amt.pay{color:var(--green)}
.tag{font-size:9px;font-weight:800;padding:3px 8px;border-radius:6px;background:#ffe39a;color:#7a5200}.tag.paid,.tag.ontime{background:#c9f0d4;color:#0b6a31}.tag.overdue{background:#ffd0d0;color:#a91418}
.activity-row{display:flex;justify-content:space-between;gap:8px;font-size:12px;font-weight:700;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.5)}
.activity-row small{display:block;font-weight:400;font-size:10px;color:var(--ink-soft)}
.empty{font-size:12px;color:var(--ink-soft);text-align:center;padding:14px}

/* showcase pages */
.page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
.kicker{font-size:11px;font-weight:800;margin-bottom:6px;color:var(--gold)}
body[data-page="products"]:not(.dark) .kicker{color:var(--red-700)}
.toolbar-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:18px}
.search{flex:1;min-width:220px;padding:12px 16px;border-radius:12px;border:1px solid rgba(255,255,255,.5);background:rgba(255,255,255,.92);font-size:13px;color:#482d1f}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--gold);background:#fff;color:#482d1f;font-size:11px;font-weight:700;padding:7px 14px;border-radius:999px}.chip.active{background:var(--gold)}
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
.pcard{background:#fff;color:#482d1f;border:1.5px solid var(--gold);border-radius:16px;padding:14px}
.pcard-top{display:flex;gap:12px;align-items:center;margin-bottom:12px}.pimage{width:56px;height:56px;border:1.5px solid var(--gold);border-radius:12px;object-fit:cover;background:#fff7dd}
.pcat{display:inline-block;font-size:9px;font-weight:800;padding:2px 8px;background:#ffe39a;border-radius:6px}.pname{font-weight:800;font-size:14px;margin:3px 0}.pprice{color:var(--red-600);font-weight:800;font-size:15px}
.pstock{display:flex;justify-content:space-between;background:#fff1c2;border:1px solid var(--gold);padding:8px 10px;border-radius:8px;font-size:12px;margin-bottom:10px}
.pactions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.pactions button{padding:8px;border-radius:8px;border:1px solid var(--gold);background:#fff;font-weight:700;font-size:12px}
.padd{border:2px dashed var(--red-600);background:transparent;border-radius:16px;min-height:200px;color:#482d1f;font-weight:800;display:grid;place-items:center;font-size:14px}.padd b{display:block;font-size:34px;color:var(--red-600);text-align:center}
.summary{display:flex;justify-content:space-between;margin-top:18px;font-size:12px;color:#7a5a46}

.client-layout{display:grid;grid-template-columns:.8fr 1.4fr;gap:26px;align-items:start}
.client-layout h2{font-size:19px;margin:8px 0}
.panel{background:rgba(255,248,220,.95);color:#482d1f;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.panel-top{padding:14px;display:grid;gap:10px;border-bottom:1px solid rgba(143,17,23,.12)}
.trow{display:grid;grid-template-columns:1.6fr .8fr 1fr .9fr 1.1fr;gap:8px;align-items:center;padding:12px 14px;font-size:12px;border-bottom:1px solid rgba(143,17,23,.08)}
.trow.head{background:rgba(143,17,23,.08);font-weight:800;font-size:11px}
.trow small{display:block;color:var(--ink-soft)}
.iconbtn{border:1px solid var(--gold);background:#fff;border-radius:8px;padding:5px 8px;font-size:13px;margin-right:3px}
.reminder{margin-top:16px;display:flex;justify-content:space-between;gap:14px;align-items:center;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.5);border-radius:14px;padding:14px;backdrop-filter:blur(10px)}
.reminder small{display:block;margin-top:5px;font-size:11px;opacity:.9}

.report-filters{display:grid;grid-template-columns:1fr 1fr 2fr auto;gap:12px;align-items:end;margin-bottom:18px}
.report-filters .form-group{margin:0}.report-filters label{color:#fff}
.rstats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
.rstat{background:rgba(255,248,220,.95);color:#482d1f;border-radius:16px;padding:16px}.rstat span{font-size:11px;font-weight:700}.rstat strong{display:block;font-size:24px;margin:8px 0;color:var(--red-700)}.rstat em{font-style:normal;font-size:11px;color:var(--green);font-weight:700}
.rgrid{display:grid;grid-template-columns:1.5fr 1fr;gap:16px;margin-bottom:18px}
.rpanel{background:rgba(255,248,220,.95);color:#482d1f;border-radius:16px;padding:18px}.rpanel h3{font-size:14px;margin-bottom:12px}
.legend{display:flex;gap:14px;font-size:11px;margin-bottom:10px;flex-wrap:wrap}.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px}
.bars{display:flex;align-items:flex-end;justify-content:space-around;height:200px;border-bottom:1px solid rgba(0,0,0,.15)}
.bgroup{display:flex;align-items:flex-end;gap:5px;height:100%;position:relative;padding-bottom:18px}.bgroup b{width:22px;border-radius:5px 5px 0 0;min-height:3px;transition:height .5s}.bgroup span{position:absolute;bottom:-1px;left:50%;transform:translate(-50%,100%);font-size:10px;white-space:nowrap}
.c-credit{background:var(--red-600)}.c-pay{background:var(--green)}.c-over{background:var(--gold)}
.bd{margin-bottom:14px;font-size:12px}.bd div:first-child{display:flex;justify-content:space-between;margin-bottom:5px;font-weight:700}.bd .track{height:9px;background:rgba(0,0,0,.1);border-radius:9px;overflow:hidden}.bd .track i{display:block;height:100%}
.ttable{background:rgba(255,248,220,.95);color:#482d1f;border-radius:16px;overflow:hidden}.ttable h3{padding:14px;font-size:14px}.ttable .trow{grid-template-columns:1.2fr 1.4fr .8fr .8fr .8fr}

.faq-item{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.4);border-radius:12px;margin-bottom:10px;backdrop-filter:blur(8px)}
.faq-q{width:100%;display:flex;justify-content:space-between;background:none;border:0;color:#fff;font-weight:700;font-size:13px;padding:14px;text-align:left}
.faq-a{display:none;padding:0 14px 14px;font-size:12px;line-height:1.6;opacity:.92}.faq-item.open .faq-a{display:block}
.contact-layout{display:grid;grid-template-columns:1.2fr 1fr;gap:26px}.contact-layout h1{font-size:34px;letter-spacing:-1px;margin:6px 0 10px}.contact-layout h1 span{color:var(--gold)}.contact-layout p{font-size:13px;margin-bottom:18px}

.map-layout{display:grid;grid-template-columns:1fr 320px;gap:16px}
#map{height:520px;border-radius:var(--radius);border:2px solid rgba(255,255,255,.6);box-shadow:var(--shadow);background:#eee;z-index:1}
.map-list{display:grid;gap:10px;align-content:start;max-height:520px;overflow:auto}
.map-item{text-align:left;width:100%;border:1px solid rgba(255,255,255,.55);border-radius:12px;padding:12px;background:rgba(255,248,220,.95);color:#482d1f;font-size:13px;font-weight:800}.map-item small{display:block;font-weight:400;color:var(--ink-soft);margin-top:3px}.map-item:hover{border-color:var(--gold)}

dialog{margin:auto;border:0;border-radius:18px;padding:22px;width:min(420px,92%);background:#fff8dc;color:#482d1f;box-shadow:var(--shadow)}
dialog::backdrop{background:rgba(60,0,0,.55);backdrop-filter:blur(3px)}
dialog h3{margin-bottom:14px}.modal-fields{display:grid;gap:12px;margin-bottom:16px}

@media(max-width:900px){
  .client-layout,.contact-layout,.rgrid,.map-layout{grid-template-columns:1fr}
  .rstats{grid-template-columns:1fr 1fr}.report-filters{grid-template-columns:1fr 1fr}
  .trow{grid-template-columns:1fr 1fr;} .trow.head{display:none}
  #map{height:380px}
}

#authScreen{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;overflow:auto;padding:24px 16px;color:#482d1f;
  background:radial-gradient(circle at 10% 20%,rgba(255,191,50,.3),transparent 28%),linear-gradient(135deg,#8f1117,#c91b1c 45%,#a91418)}
.auth-shell{width:min(980px,100%);display:grid;grid-template-columns:1fr 1fr;border-radius:28px;overflow:hidden;border:1px solid rgba(255,255,255,.45);background:rgba(255,255,255,.16);box-shadow:0 25px 60px rgba(62,0,0,.35);backdrop-filter:blur(18px)}
.auth-brand-panel{padding:44px 38px;color:#fff;background:linear-gradient(145deg,rgba(105,7,15,.6),rgba(201,27,28,.25));display:flex;flex-direction:column;gap:14px}
.auth-brand{font-size:32px;font-weight:900;letter-spacing:-2px}.auth-brand span{color:var(--gold)}
.auth-brand-panel h1{font-size:clamp(30px,4vw,44px);line-height:1.08;letter-spacing:-1.5px;margin-top:40px}.auth-brand-panel h1 em{font-style:normal;color:var(--gold)}
.auth-brand-panel p{font-size:14px;line-height:1.7;opacity:.88}
.auth-points{display:grid;gap:14px;margin-top:20px;font-size:12px}.auth-points b{display:block;font-size:13px}.auth-points small{opacity:.8}
.auth-form-panel{padding:40px 38px;background:linear-gradient(135deg,rgba(255,248,220,.9),rgba(255,243,199,.75))}
.auth-form-panel h2{font-size:26px;letter-spacing:-.8px;margin-bottom:6px}.auth-form-panel>p{font-size:13px;color:var(--ink-soft);margin-bottom:18px}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;padding:4px;border-radius:12px;background:rgba(143,17,23,.08);margin-bottom:18px}
.auth-tabs button{border:0;background:none;padding:10px;border-radius:9px;font-weight:700;font-size:12px;color:var(--ink-soft)}.auth-tabs button.active{background:#fff;color:var(--red-700)}
.auth-field{margin-bottom:13px}.auth-field label{display:block;font-size:11px;font-weight:800;margin-bottom:6px}
.auth-field input{width:100%;height:46px;padding:0 14px;border-radius:12px;border:1px solid rgba(143,17,23,.2);background:rgba(255,255,255,.75);font-size:13px;color:#482d1f}
.auth-roles{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:13px}
.auth-roles button{border:1px solid rgba(143,17,23,.2);background:rgba(255,255,255,.5);border-radius:12px;padding:10px;text-align:left;font-size:12px;font-weight:800}.auth-roles button.selected{border-color:var(--red-600);background:#fff}
.auth-msg{font-size:12px;color:var(--red-700);min-height:16px;margin-bottom:8px}.auth-msg.ok{color:#087b37}
.auth-submit{width:100%;padding:14px;border:1px solid rgba(255,255,255,.6);border-radius:12px;color:#fff;font-weight:800;font-size:14px;background:linear-gradient(135deg,var(--red-600),var(--red-900));box-shadow:0 9px 21px rgba(143,17,23,.3)}
.auth-demo{margin-top:12px;font-size:11px;text-align:center;color:var(--ink-soft)}.auth-demo button{border:0;background:none;color:var(--red-700);font-weight:800;text-decoration:underline}
@media(max-width:760px){.auth-shell{grid-template-columns:1fr}.auth-brand-panel{display:none}}
</style>
</head>
<body>

<!-- ============ ACCESO ============ -->
<section id="authScreen" aria-label="Acceso a FIA'O">
  <div class="auth-shell">
    <div class="auth-brand-panel">
      <div class="auth-brand">FIA<span>’O</span></div>
      <h1>Mantén tu negocio <em>en movimiento.</em></h1>
      <p>Una forma clara de manejar fiados, pagos y clientes del día a día.</p>
      <div class="auth-points">
        <div><b>Sabe cuánto te deben</b><small>Saldos y movimientos de un vistazo</small></div>
        <div><b>Controla tu crédito</b><small>Bloqueo automático al pasar el límite</small></div>
        <div><b>Encuentra FIA’O</b><small>Mapa de las zonas donde estamos</small></div>
      </div>
    </div>
    <div class="auth-form-panel">
      <h2 id="authTitle">Inicia sesión</h2>
      <p id="authSub">Tu negocio, justo donde lo dejaste.</p>
      <div class="auth-tabs">
        <button type="button" class="active" data-mode="signin">Iniciar sesión</button>
        <button type="button" data-mode="signup">Crear cuenta</button>
      </div>
      <form id="authForm" novalidate>
        <div id="signupExtra" hidden>
          <div class="auth-field"><label for="aName">Nombre completo</label><input id="aName" autocomplete="name"></div>
          <div class="auth-roles">
            <button type="button" class="selected" data-role="owner">Dueño de negocio</button>
            <button type="button" data-role="client">Cliente</button>
          </div>
        </div>
        <div class="auth-field"><label for="aEmail">Correo</label><input id="aEmail" type="email" placeholder="tu@correo.com" autocomplete="email"></div>
        <div class="auth-field"><label for="aPass">Contraseña</label><input id="aPass" type="password" placeholder="Mínimo 6 caracteres" autocomplete="current-password"></div>
        <div class="auth-field" id="confirmWrap" hidden><label for="aConfirm">Confirmar contraseña</label><input id="aConfirm" type="password" autocomplete="new-password"></div>
        <div class="auth-msg" id="authMsg" role="status" aria-live="polite"></div>
        <button class="auth-submit" id="authSubmit" type="submit">Iniciar sesión</button>
      </form>
      <p class="auth-demo">¿Solo quieres probar? <button type="button" id="demoLogin">Entrar con cuenta demo</button></p>
    </div>
  </div>
</section>

<div id="app">
<nav class="navbar">
  <div class="logo">FIA<span>’O</span></div>
  <button class="menu" id="menuButton" aria-label="Menú">☰</button>
  <div class="nav-links" id="navLinks">
